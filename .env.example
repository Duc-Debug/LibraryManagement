# =========================================================================
# Docker Compose Environment Configuration Template
# =========================================================================
# Copy this file to a new file named '.env' and fill in your secure credentials.
# The '.env' file is ignored by Git to prevent leaking secrets.

# --- Database Configs ---
MYSQL_DATABASE=library_management
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rootpassword123

# --- Database Secrets (Change in production!) ---
MYSQL_ROOT_PASSWORD=rootpassword123

# --- Security Configs ---
# JWT Secret key must be a secure base64 string
JWT_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000

# CORS Configuration (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Configs ---
# In production, point these to your public domain (e.g., https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Cloudflare R2 Storage Configs ---
R2_ENDPOINT=https://your-cloudflare-r2-endpoint-here
R2_ACCESS_KEY=your-r2-access-key-here
R2_SECRET_KEY=your-r2-secret-key-here
R2_BUCKET_NAME=your-r2-bucket-name-here
R2_PUBLIC_URL=https://your-r2-public-url-here



