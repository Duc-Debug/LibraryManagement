# =========================================================================
# Docker Compose Local Environment Configuration (Template)
# =========================================================================

# --- Database Configs ---
MYSQL_DATABASE=library_management
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# --- Database Secrets ---
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# --- Security Configs ---
# JWT Secret key (should be a secure random 256-bit base64-encoded string)
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000

# CORS Configuration (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Configs ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Cloudflare R2 Storage Configs ---
R2_ENDPOINT=https://your-cloudflare-r2-endpoint.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key_here
R2_SECRET_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-public-r2-url.dev
