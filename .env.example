# =========================================================================
# Docker Compose Local Environment Configuration
# =========================================================================

# --- Database Configs ---
MYSQL_DATABASE=library_management
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password

# --- Database Secrets ---
MYSQL_ROOT_PASSWORD=your_root_password

# --- Security Configs ---
JWT_SECRET=your_jwt_secret_base64_encoded_at_least_256_bits
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000

# CORS Configuration (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Configs ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Cloudflare R2 Storage Configs ---
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-access-key
R2_SECRET_KEY=your-secret-key
R2_BUCKET_NAME=library-management
R2_PUBLIC_URL=https://pub-your-public-bucket-url.r2.dev
